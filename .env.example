# Optional. If omitted, the app loads assets from /dist-assets on the same origin.
VITE_ASSET_BASE_URL=/dist-assets

# Cloudflare R2 asset hosting. Keep VITE_ASSET_BASE_URL aligned with R2_ASSET_DOMAIN + release prefix.
# Credentials for rclone's R2/S3 remote stay outside this repo in rclone config.
R2_BUCKET=xiaomi-webusb-assets
R2_REMOTE=r2
R2_ASSET_DOMAIN=https://assets.example.com
R2_RELEASE=20260617-001
R2_PREFIX=xiaomi-webusb/releases/20260617-001
R2_SOURCE_DIR=dist-assets
R2_VERIFY_ORIGIN=http://localhost:5173
# VITE_ASSET_BASE_URL=https://assets.example.com/xiaomi-webusb/releases/20260617-001

# payOS / backend. Keep real values in .env.local or service environment only.
PAYMENTS_PORT=8787
PAYMENTS_DATABASE_PATH=server/data/payments.db
PAYMENTS_PUBLIC_BASE_URL=http://localhost:5173
PAYMENTS_PROVIDER=mock
# Production blocks PAYMENTS_PROVIDER=mock unless this is explicitly true.
# PAYMENTS_ALLOW_MOCK_IN_PRODUCTION=false
PAYMENTS_ADMIN_TOKEN=replace-with-local-admin-token
PAYMENTS_ASSET_KEYS_PATH=server/data/payment-asset-keys.local.json
# Developer Override V2 is disabled when this is empty. Store real values only in .env.local or backend service env.
DEVELOPER_OVERRIDE_MASTER_KEY=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/payment/return
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel
PAYOS_WEBHOOK_URL=http://localhost:8787/api/payments/webhook/payos
