# Optional. If omitted, the app loads assets from /dist-assets on the same origin.
VITE_ASSET_BASE_URL=/dist-assets

# Cloudflare R2 asset hosting. Keep VITE_ASSET_BASE_URL aligned with R2_ASSET_DOMAIN + release prefix.
# Credentials for rclone's R2/S3 remote stay outside this repo in rclone config.
R2_BUCKET=xiaomi-webusb-assets
R2_REMOTE=r2
R2_ASSET_DOMAIN=https://assets.example.com
R2_RELEASE=20260506-001
R2_PREFIX=xiaomi-webusb/releases/20260506-001
R2_SOURCE_DIR=dist-assets
R2_VERIFY_ORIGIN=http://localhost:5173
# VITE_ASSET_BASE_URL=https://assets.example.com/xiaomi-webusb/releases/20260506-001
