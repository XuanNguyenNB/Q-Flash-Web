# Q-Flash-Web Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# AI PROXY SERVER CONFIGURATION (Recommended)
# ============================================
# Use proxy server for better security and rate limiting
VITE_AI_PROXY_URL=
VITE_AI_PROXY_API_KEY=
VITE_AI_MODEL=gemini-2.5-flash

# ============================================
# DIRECT GEMINI API (Alternative - not recommended for production)
# ============================================
# Get your key at: https://makersuite.google.com/app/apikey
# Only use this if proxy server is not available
VITE_GEMINI_API_KEY=
