{
  "name": "webusb-xiaomi-unlock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p server/tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:dev": "tsx server/src/index.ts",
    "server:start": "node server/dist/index.js",
    "server:test": "vitest run server",
    "download:eng-roms": "powershell -ExecutionPolicy Bypass -File scripts/download-eng-roms.ps1",
    "download:vhmobile-minieng": "tsx scripts/download-vhmobile-minieng.ts",
    "download:vhmobile-minieng:dry-run": "tsx scripts/download-vhmobile-minieng.ts --dry-run",
    "audit:vhmobile-minieng": "tsx scripts/download-vhmobile-minieng.ts --audit-only",
    "build:assets": "tsx scripts/build-assets.ts --clean",
    "sync:assets:r2": "tsx scripts/sync-assets-r2.ts",
    "sync:assets:r2:dry-run": "tsx scripts/sync-assets-r2.ts --dry-run",
    "verify:assets:r2": "tsx scripts/verify-assets-r2.ts",
    "verify:assets:r2:dry-run": "tsx scripts/verify-assets-r2.ts --dry-run",
    "audit:deps": "npm audit signatures && npm audit --omit=dev",
    "check:csp": "node scripts/check-csp.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "~4.2.4",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "~16.3.2",
    "@testing-library/user-event": "~14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "~25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "~6.0.1",
    "jsdom": "~29.0.2",
    "tailwindcss": "~4.2.4",
    "tsx": "~4.21.0",
    "typescript": "~6.0.2",
    "vite": "~8.0.10",
    "vite-plugin-sri3": "^2.0.0",
    "vitest": "~4.1.5"
  },
  "dependencies": {
    "@yume-chan/adb": "2.6.0",
    "@yume-chan/adb-credential-web": "2.1.0",
    "@yume-chan/adb-daemon-webusb": "2.3.2",
    "@yume-chan/stream-extra": "2.5.3",
    "android-fastboot": "1.1.3",
    "express": "^5.2.1",
    "lucide-react": "~1.9.0",
    "qrcode": "^1.5.4",
    "react": "~19.2.5",
    "react-dom": "~19.2.5",
    "zod": "~4.3.6"
  },
  "overrides": {
    "@yume-chan/adb": "2.6.0",
    "@yume-chan/adb-credential-web": "2.1.0",
    "@yume-chan/adb-daemon-webusb": "2.3.2",
    "@yume-chan/stream-extra": "2.5.3",
    "android-fastboot": "1.1.3",
    "esbuild": "^0.28.1"
  }
}
